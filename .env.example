# Plantilla de variables de entorno.
# Copia este archivo a  .env  y llena los valores LOCALMENTE.
# El archivo .env NUNCA se sube al repositorio (ver .gitignore).
# Aquí van solo los NOMBRES de las variables y valores de EJEMPLO para
# desarrollo local; nunca contraseñas, tokens ni llaves reales.

# ── Aplicación ─────────────────────────────
APP_ENV=dev                 # dev | prod
APP_PORT=8000               # puerto de la API en el host
WEB_PORT=4200               # puerto del frontend (ng serve en el servicio "web") en el host
# Destino del proxy /api del frontend en Docker. Por defecto la API de compose (http://api:8000);
# `make up-gpu` lo cambia a la API en el host. Descomentar solo para fijarlo a mano.
# API_URL_WEB=http://host.docker.internal:8000
APP_SECRET_KEY=change-me-dev-only

# ── Base de datos (PostgreSQL 16 + pgvector) ─────────────
# Con venv/notebooks/tests la base se alcanza en localhost.
# En docker compose, el servicio "api" sobrescribe POSTGRES_HOST=db.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432          # puerto en el host; cámbialo si ya está ocupado
POSTGRES_DB=sopvid
POSTGRES_USER=sopvid
POSTGRES_PASSWORD=sopvid-dev-only
# Opcional: si se define, tiene prioridad sobre las POSTGRES_* de arriba.
# DATABASE_URL=postgresql+psycopg://sopvid:sopvid-dev-only@localhost:5432/sopvid

# ── Datos públicos de los avances académicos ──
# Ruta de las anotaciones de CaptainCook4D (se descargan solas; nunca se versionan).
# Si es relativa, se resuelve contra la raíz del repo.
DATA_DIR=data/raw/captaincook4d

# ── Medios (videos, audio extraído, fotogramas, PDF) ──
# Relativa = contra la raíz del repo; ignorada por Git (material del cliente, NDA).
MEDIA_DIR=media
FFMPEG_TIMEOUT_S=300        # tope por llamada a ffmpeg/ffprobe, en segundos
SUBIDA_MAX_MB=1024          # tamaño máximo de un video en POST /videos
# En Docker, docker-compose.yml fija MEDIA_DIR=/app/media (volumen "media").

# ── Transcripción con faster-whisper (RF-09, RF-10; ver docs/dev/transcripcion.md) ──
# El mismo modelo en CPU y en GPU (ADR-018): large-v3-turbo, int8 en CPU y float16 en cuda.
# La GPU solo acelera (venv con `pip install -e .[gpu]`; en Docker todavía no hay GPU).
WHISPER_MODELO=large-v3-turbo      # nombre de faster-whisper o carpeta local con el modelo convertido
WHISPER_MODELO_CPU=large-v3-turbo  # modelo si Whisper corre en CPU; vacío, el de WHISPER_MODELO.
#                                  # Otro (p. ej. small) es más rápido, pero el reporte sale con el
#                                  # aviso transcripcion_no_referencia (provisional).
WHISPER_DISPOSITIVO=auto    # auto | cpu | cuda. auto: cuda si hay GPU NVIDIA; si falla, CPU con aviso
WHISPER_COMPUTE_TYPE=auto   # auto: float16 en cuda, int8 en cpu
# WHISPER_DISPOSITIVO=cuda  # cuda explícito: si falla, error en lugar de caer a CPU
# La api de docker compose corre en CPU y usa WHISPER_MODELO_CPU (large-v3-turbo por defecto).
# Pesos (~1.6 GB large-v3-turbo, ~0.5 GB small). Relativa = contra la raíz del repo; ignorada
# por Git. En Docker, docker-compose.yml la fija en el volumen "modelos".
WHISPER_CACHE_DIR=models/whisper

# ── LLM local vía Ollama (ADR-006; ver docs/dev/llm.md) ──
# Dónde está Ollama, según quién lo llama:
#   http://localhost:11434             scripts, tests y notebooks desde el host
#                                      (Ollama en Docker con el profile "llm" o nativo).
#                                      En Windows usa http://127.0.0.1:11434: "localhost"
#                                      prueba IPv6 primero y pierde ~2 s por conexión.
#   http://ollama:11434                la API dentro de Docker con el profile "llm"
#   http://host.docker.internal:11434  la API dentro de Docker con Ollama nativo (respaldo)
# La API en Docker no usa LLM_BASE_URL: docker-compose.yml le pasa LLM_BASE_URL_API
# (por defecto http://ollama:11434), igual que hace con POSTGRES_HOST=db.
LLM_BASE_URL=http://127.0.0.1:11434
# LLM_BASE_URL_API=http://host.docker.internal:11434
# Modelo que usa la API y que descarga el servicio ollama-pull.
LLM_MODEL=gemma4:e4b-it-q4_K_M  # recomendado en ADR-006 para GPU de 8 GB
LLM_TIMEOUT_S=180           # por petición; cubre la carga en frío del modelo (36-78 s medidos)
LLM_NUM_CTX=8192            # ventana de contexto en tokens; más contexto = más VRAM
LLM_NUM_CTX_SOP=16384       # ventana para un SOP sin plantilla que no cabe en LLM_NUM_CTX; si no, 422
LLM_HEALTH_TIMEOUT_S=2      # tope de la consulta del LLM en GET /health
LLM_INACTIVIDAD_S=60        # conversión del SOP: corta si pasan estos segundos sin un token
LLM_TIMEOUT_SOP_S=900       # conversión del SOP: tope total aunque siga generando (CPU: 150-200 s)
LLM_TIMEOUT_CONTEXTO_S=600  # ficha de contexto: tope total con sus reintentos (mismos cortes que el SOP)
# Dónde corre Gemma (ADR-018). auto: Ollama usa la GPU si la ve y si no la CPU.
# cpu: se pide num_gpu=0 y corre solo en CPU (para medir sin GPU). El modelo no cambia.
LLM_DISPOSITIVO=auto       # auto | cpu

# ── MiniLM para emparejar pasos (ADR-012; siempre en CPU) ──
EMBEDDER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Caché de pesos (~470 MB la primera vez). Relativa = contra la raíz del repo; ignorada por Git.
# En Docker, docker-compose.yml la fija en el volumen "modelos".
EMBEDDER_CACHE_DIR=models/embedder
# HF_HUB_OFFLINE=1  # tras la primera descarga, para cargar MiniLM y Whisper sin consultar el Hub
# Umbrales de coseno, entre 0 y 1, con UMBRAL_BAJO <= UMBRAL_ALTO (ADR-012, ADR-013).
UMBRAL_BAJO=0.55            # por debajo: sin pareja (Falta / Sobra), sin LLM
UMBRAL_ALTO=0.75            # desde aquí la pareja se acepta; en medio decide Gemma 4
UMBRAL_FUSION=0.55          # pasos consecutivos del video con el mismo paso del SOP se unen
SOP_CANDADO=false           # SOP generado: parte un "continua" de Gemma con coseno < UMBRAL_FUSION (ADR-023; apagado: cortaba bien agrupados)
UMBRAL_EQUIPO=0.85          # SOP generado: une dos nombres de equipo (en español) con coseno MiniLM ≥ este valor (ADR-023)

# ── Semáforo de cumplimiento (RF-19; SOP V1.0 §5.6) ──
# Porcentaje entre 0 y 100, con SEMAFORO_VERDE > SEMAFORO_AMARILLO.
SEMAFORO_VERDE=90           # desde aquí, verde
SEMAFORO_AMARILLO=70        # desde aquí y por debajo del verde, amarillo; abajo, rojo

# ── Contexto, personas y tiempos del reporte (RF-15, RF-16, RF-17; SOP V1.0 §5.2–5.5) ──
AFINIDAD_MIN=60             # 0–100: por debajo, "El video parece no corresponder a este SOP"
AFINIDAD_COS_CERO=0.30      # coseno MiniLM que vale 0 en cada componente de la afinidad (ADR-020, SIN CALIBRAR)
AFINIDAD_COS_CIEN=0.80      # coseno que vale 100; lineal entre los dos (SIN CALIBRAR)
AFINIDAD_UMBRAL_EQUIPO=0.75 # coseno para que un equipo del SOP cuente como "en común" (SIN CALIBRAR)
TOLERANCIA_TIEMPO=0.20      # 0–1: margen sobre el tiempo esperado (en tiempo / excede / menor)
UMBRAL_ROL=0.85             # coseno 0–1 entre los núcleos de dos roles ("técnico", "supervisor") (SIN CALIBRAR)
UMBRAL_ROL_COMPLEMENTO=0.70 # coseno entre complementos ("de mantenimiento") si los dos roles lo traen (SIN CALIBRAR)
UMBRAL_HORARIO=0.75         # coseno 0–1 entre el horario del SOP y el que menciona el video (SIN CALIBRAR)

# ── Imágenes del video (RF-11, ADR-024) ──
# La miniatura por paso se saca siempre, con ffmpeg y sin modelo (media/videos/<id>/miniaturas/).
MINIATURA_LADO_PX=320       # lado mayor del JPEG de la miniatura
# Describir imágenes con Gemma antes de la ficha: apagado por defecto. `analizar_imagenes` de
# POST /videos gana sobre este valor, video por video. Sin GPU describe igual, más lento.
FOTOGRAMAS_DESCRIBIR=false
PASOS_POR_MIN=2.2           # N en modo generar = minutos × esto (mediana de A, B, C y E; SIN CALIBRAR)
FOTOGRAMAS_MIN=4            # N mínimo
FOTOGRAMAS_MAX=20           # N máximo (tope de ADR-002; no puede pasar de 20)
FOTOGRAMAS_LADO_PX=512      # lado mayor del JPEG que recibe Gemma
FOTOGRAMAS_LOTE=8           # imágenes por llamada (8 caben en 8 GB de VRAM: 7.2 de pico). Palanca para
                            # equipos con menos memoria; sin memoria, baja solo a la mitad una vez
LLM_TIMEOUT_FOTOGRAMAS_S=600  # tope por lote, en flujo
SEG_IMAGEN_GPU=1.2          # segundos extra por imagen con GPU, para GET /videos/estimacion (C–E, 11 nov)
SEG_IMAGEN_CPU=10.7         # segundos extra por imagen sin GPU (C–E, 11 nov)

# ── Modelos (pesos abiertos, servibles localmente) ──
# El LLM se elige con LLM_MODEL (arriba); Ollama descarga los pesos ya cuantizados.
# VJEPA2_MODEL_PATH=        # diferido: percepción visual fuera del alcance actual
# Whisper: ver la sección Transcripción (arriba).
CUDA_VISIBLE_DEVICES=

# ── Descarga de pesos (cuenta de la organización, no personal) ──
HF_TOKEN=

# ── Almacenamiento aprobado del material del cliente ──
# El contenido vive aquí, FUERA del repo; en el repo solo se referencia por identificador.
CLIENT_STORAGE_ENDPOINT=
CLIENT_STORAGE_BUCKET=
CLIENT_STORAGE_ACCESS_KEY=
CLIENT_STORAGE_SECRET_KEY=
