# Plantilla de variables de entorno.
# Copia este archivo a  .env  y llena los valores LOCALMENTE.
# El archivo .env NUNCA se sube al repositorio (ver .gitignore).
# Aquí van solo los NOMBRES de las variables y valores de EJEMPLO para
# desarrollo local; nunca contraseñas, tokens ni llaves reales.

# ── Aplicación ─────────────────────────────
APP_ENV=dev                 # dev | prod
APP_PORT=8000               # puerto de la API en el host
APP_SECRET_KEY=change-me-dev-only

# ── Base de datos (PostgreSQL 16 + pgvector) ─────────────
# Con venv/notebooks/tests la base se alcanza en localhost.
# En docker compose, el servicio "api" sobrescribe POSTGRES_HOST=db.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432          # puerto en el host; cámbialo si ya está ocupado
POSTGRES_DB=sopvid
POSTGRES_USER=sopvid
POSTGRES_PASSWORD=sopvid-dev-only
# Opcional: si se define, tiene prioridad sobre las POSTGRES_* de arriba.
# DATABASE_URL=postgresql+psycopg://sopvid:sopvid-dev-only@localhost:5432/sopvid

# ── Modelos (pesos abiertos, servibles localmente) ──
# VJEPA2_MODEL_PATH=        # diferido: percepción visual fuera del alcance actual
GEMMA_MODEL_PATH=
WHISPER_MODEL_PATH=
MODEL_QUANTIZATION=   # p. ej. 4bit
CUDA_VISIBLE_DEVICES=

# ── Descarga de pesos (cuenta de la organización, no personal) ──
HF_TOKEN=

# ── Almacenamiento aprobado del material del cliente ──
# El contenido vive aquí, FUERA del repo; en el repo solo se referencia por identificador.
CLIENT_STORAGE_ENDPOINT=
CLIENT_STORAGE_BUCKET=
CLIENT_STORAGE_ACCESS_KEY=
CLIENT_STORAGE_SECRET_KEY=
