    "codigo": "SOP-0001",
    "titulo": "Cambio del cartucho del filtro de agua",
    "pasos": [
      {
        "numero": 1,
        "nombre": "Cerrar la llave de paso",
        "descripcion": "Girar la llave de paso que está antes del filtro a la derecha hasta el tope. La manija debe quedar atravesada a la tubería."
      },
      {
        "numero": 2,
        "nombre": "Ponerse guantes y lentes",
        "descripcion": "Colocarse los guantes de nitrilo y los lentes de seguridad antes de tocar el filtro."
      },
      {
        "numero": 3,
        "nombre": "Liberar la presión",
        "descripcion": "Mantener presionado el botón rojo de la carcasa hasta que deje de salir aire y el manómetro marque cero. Colocar la cubeta debajo del filtro."
      },
      {
        "numero": 4,
        "nombre": "Retirar la carcasa y el cartucho usado",
        "descripcion": "Aflojar el vaso con la llave de carcasa girando a la izquierda, bajarlo con cuidado y sacar el cartucho usado a la bolsa de residuos. Revisar el anillo de hule y cambiarlo si está aplastado o cuarteado."
      },
      {
        "numero": 5,
        "nombre": "Colocar el cartucho nuevo",
        "descripcion": "Quitar el plástico al cartucho nuevo, meterlo centrado en el vaso con la ranura hacia arriba, enroscar el vaso a mano y dar un cuarto de vuelta con la llave, sin apretar de más."
      },
      {
        "numero": 6,
        "nombre": "Abrir la llave y revisar fugas",
        "descripcion": "Abrir la llave de paso despacio, purgar el aire con el botón rojo hasta que salga solo agua y revisar la unión del vaso y las conexiones con una toalla de papel."
      },
      {
        "numero": 7,
        "nombre": "Registrar el cambio en la bitácora",
        "descripcion": "Anotar la fecha, el cartucho instalado y la presión final."
      }
    ]
  },
