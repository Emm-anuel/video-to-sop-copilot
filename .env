# Plantilla de variables de entorno.
# Copia este archivo a  .env  y llena los valores LOCALMENTE.
# El archivo .env NUNCA se sube al repositorio (ver .gitignore).
# Aquí van solo los NOMBRES de las variables, sin valores.

# ── Aplicación ─────────────────────────────
APP_ENV=            # dev | prod
APP_PORT=
APP_SECRET_KEY=

# ── Base de datos (PostgreSQL) ─────────────
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ── Modelos (pesos abiertos, servibles localmente) ──
VJEPA2_MODEL_PATH=
GEMMA_MODEL_PATH=
WHISPER_MODEL_PATH=
MODEL_QUANTIZATION=   # p. ej. 4bit
CUDA_VISIBLE_DEVICES=

# ── Descarga de pesos (cuenta de la organización, no personal) ──
HF_TOKEN=

# ── Almacenamiento aprobado del material del cliente ──
# El contenido vive aquí, FUERA del repo; en el repo solo se referencia por identificador.
CLIENT_STORAGE_ENDPOINT=
CLIENT_STORAGE_BUCKET=
CLIENT_STORAGE_ACCESS_KEY=
CLIENT_STORAGE_SECRET_KEY=
